digraph G { rankdir=LR; bgcolor="white"; nodesep=0.5; ranksep=0.8;
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#475569", arrowhead=crow, fontname="Helvetica", fontsize=9];
machines [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EFF6FF"><tr><td bgcolor="#1E3A8A"><font color="white"><b>machines</b></font></td></tr><tr><td align="left">PK machine_id<br align="left"/>machine_type<br align="left"/>created_at<br align="left"/></td></tr></table>>];
sr [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EFF6FF"><tr><td bgcolor="#1E3A8A"><font color="white"><b>sensor_readings</b></font></td></tr><tr><td align="left">PK reading_id<br align="left"/>FK machine_id<br align="left"/>timestamp<br align="left"/>air_temperature, temperature<br align="left"/>rotational_speed, torque<br align="left"/>tool_wear<br align="left"/></td></tr></table>>];
fe [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EFF6FF"><tr><td bgcolor="#1E3A8A"><font color="white"><b>failure_events</b></font></td></tr><tr><td align="left">PK failure_id<br align="left"/>FK machine_id<br align="left"/>timestamp<br align="left"/>failure_type<br align="left"/></td></tr></table>>];
pr [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EFF6FF"><tr><td bgcolor="#1E3A8A"><font color="white"><b>predictions</b></font></td></tr><tr><td align="left">PK prediction_id<br align="left"/>FK machine_id<br align="left"/>prediction_time<br align="left"/>failure_probability, risk_level<br align="left"/>is_anomaly, anomaly_score/level<br align="left"/>estimated_rul<br align="left"/>likely_failure_type<br align="left"/>top_factors, model_version<br align="left"/></td></tr></table>>];
mt [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EFF6FF"><tr><td bgcolor="#1E3A8A"><font color="white"><b>maintenance</b></font></td></tr><tr><td align="left">PK maintenance_id<br align="left"/>FK machine_id<br align="left"/>date, action, technician<br align="left"/>issue, priority<br align="left"/>scheduled_date, status<br align="left"/>notes, created_at<br align="left"/></td></tr></table>>];
machines -> sr [arrowtail=none, dir=both, arrowhead=crow]; machines -> fe [dir=both, arrowhead=crow]; machines -> pr [dir=both, arrowhead=crow]; machines -> mt [dir=both, arrowhead=crow]; }
